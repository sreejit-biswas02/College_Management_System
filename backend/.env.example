APP_NAME=College Management System
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/college_management
DIRECT_DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://127.0.0.1:5500

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Object Storage (Cloudflare R2 / S3-compatible)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=college-management-files
R2_ENDPOINT_URL=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=
MAX_DOCUMENT_UPLOAD_BYTES=10485760
MAX_ASSIGNMENT_UPLOAD_BYTES=20971520
SIGNED_URL_EXPIRE_SECONDS=300
